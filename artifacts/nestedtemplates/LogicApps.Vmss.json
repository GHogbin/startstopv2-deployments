{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Region for the Logic Apps." }
    },
    "scheduleTimeZone": {
      "type": "string",
      "defaultValue": "GMT Standard Time",
      "metadata": { "description": "IANA Windows time-zone name for the recurrence triggers." }
    },
    "startSchedule": {
      "type": "object",
      "defaultValue": { "hours": [ "7" ], "minutes": [ 0 ] },
      "metadata": { "description": "Recurrence schedule object for the start workflow." }
    },
    "stopSchedule": {
      "type": "object",
      "defaultValue": { "hours": [ "19" ], "minutes": [ 0 ] },
      "metadata": { "description": "Recurrence schedule object for the stop workflow." }
    },
    "scaleToOneSchedule": {
      "type": "object",
      "defaultValue": { "hours": [ "7" ], "minutes": [ 0 ] },
      "metadata": { "description": "Recurrence schedule object for the scale-to-one workflow." }
    },
    "scaleToOneCapacity": {
      "type": "int",
      "defaultValue": 1,
      "metadata": { "description": "Target instance count applied to tagged VMSS by the scale-to-one workflow." }
    },
    "autoStopRecurrenceMinutes": {
      "type": "int",
      "defaultValue": 15,
      "metadata": { "description": "How often (minutes) the AutoStop workflow scans for VMSS with the auto-stop tag." }
    },
    "logicAppState": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [ "Enabled", "Disabled" ],
      "metadata": { "description": "Initial state of the Logic Apps. Keep Disabled until you've reviewed schedules and tags." }
    },
    "targetSubscriptionIds": {
      "type": "array",
      "defaultValue": [ "[subscription().subscriptionId]" ],
      "metadata": { "description": "Subscription IDs (Resource Graph scope) to search for tagged VMSS." }
    },
    "targetResourceGroups": {
      "type": "array",
      "defaultValue": [],
      "metadata": { "description": "Optional. Resource group NAMES to restrict the search to (case-insensitive). Empty array = all RGs in the target subscriptions. Example: [ \"rg-prod-vmss\", \"rg-dev-vmss\" ]." }
    },
    "tagName": {
      "type": "string",
      "defaultValue": "StartStopV2_VMSS",
      "metadata": { "description": "Tag key on VMSS that opts them in for start/stop/autostop. Recognized values: 'start', 'stop', 'both', 'autostop'." }
    },
    "scaleTagName": {
      "type": "string",
      "defaultValue": "StartStopV2_VMSS_Scale",
      "metadata": { "description": "Separate tag key on VMSS that opts them in to the scale-to-one workflow. Recognized value: 'scaleto1'. Independent of tagName so a VMSS can be tagged for both start/stop and scale-to-one." }
    },
    "assignRbac": {
      "type": "bool",
      "defaultValue": true,
      "metadata": { "description": "If true, assign Virtual Machine Contributor to each Logic App's managed identity at the current resource group scope. Set false if you want to assign roles manually at a broader scope." }
    },
    "vmssApiVersion": {
      "type": "string",
      "defaultValue": "2024-03-01",
      "metadata": { "description": "VMSS REST API version used for start/deallocate calls." }
    }
  },
  "variables": {
    "logicApp_Start": "ststv2_vmss_Scheduled_start",
    "logicApp_Stop": "ststv2_vmss_Scheduled_stop",
    "logicApp_AutoStop": "ststv2_vmss_AutoStop",
    "logicApp_ScaleToOne": "ststv2_vmss_Scheduled_scaleto1",
    "armEndpoint": "https://management.azure.com",
    "argEndpoint": "https://management.azure.com/providers/Microsoft.ResourceGraph/resources?api-version=2022-10-01",
    "vmContributorRoleId": "9980e02c-c2be-4d73-94e8-173b1dc7cf3c",
    "vmContributorRoleDefId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', variables('vmContributorRoleId'))]",
    "rgFilterClause": "[if(empty(parameters('targetResourceGroups')), '', concat(' | where resourceGroup in~ ', replace(replace(string(parameters('targetResourceGroups')), '[', '('), ']', ')')))]",
    "baseQuery": "resources | where type =~ 'microsoft.compute/virtualmachinescalesets'",
    "projectClause": " | project id, name, resourceGroup, subscriptionId",
    "queryStart":    "[concat(variables('baseQuery'), variables('rgFilterClause'), ' | where tostring(tags[\"', parameters('tagName'), '\"]) in~ (\"start\",\"both\")', variables('projectClause'))]",
    "queryStop":     "[concat(variables('baseQuery'), variables('rgFilterClause'), ' | where tostring(tags[\"', parameters('tagName'), '\"]) in~ (\"stop\",\"both\")',  variables('projectClause'))]",
    "queryAutoStop": "[concat(variables('baseQuery'), variables('rgFilterClause'), ' | where tostring(tags[\"', parameters('tagName'), '\"]) =~ \"autostop\"',                variables('projectClause'))]",
    "queryScaleToOne": "[concat(variables('baseQuery'), variables('rgFilterClause'), ' | where tostring(tags[\"', parameters('scaleTagName'), '\"]) =~ \"scaleto1\"',         variables('projectClause'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicApp_Start')]",
      "location": "[parameters('location')]",
      "tags": { "SolutionName": "StartStopV2", "ResourceType": "VMSS" },
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "[parameters('logicAppState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "subscriptionIds": { "type": "Array", "defaultValue": "[parameters('targetSubscriptionIds')]" },
            "tagName":         { "type": "String", "defaultValue": "[parameters('tagName')]" },
            "argEndpoint":     { "type": "String", "defaultValue": "[variables('argEndpoint')]" },
            "armEndpoint":     { "type": "String", "defaultValue": "[variables('armEndpoint')]" },
            "vmssApiVersion":  { "type": "String", "defaultValue": "[parameters('vmssApiVersion')]" },
            "action":          { "type": "String", "defaultValue": "start" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": "[parameters('startSchedule')]",
                "timeZone": "[parameters('scheduleTimeZone')]"
              }
            }
          },
          "actions": {
            "Find_VMSS": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('argEndpoint')",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" },
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "[variables('queryStart')]"
                }
              }
            },
            "Start_Each_VMSS": {
              "type": "Foreach",
              "runAfter": { "Find_VMSS": [ "Succeeded" ] },
              "foreach": "@body('Find_VMSS')?['data']",
              "actions": {
                "Invoke_Action": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat(parameters('armEndpoint'), items('Start_Each_VMSS')?['id'], '/', parameters('action'), '?api-version=', parameters('vmssApiVersion'))}",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicApp_Stop')]",
      "location": "[parameters('location')]",
      "tags": { "SolutionName": "StartStopV2", "ResourceType": "VMSS" },
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "[parameters('logicAppState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "subscriptionIds": { "type": "Array", "defaultValue": "[parameters('targetSubscriptionIds')]" },
            "tagName":         { "type": "String", "defaultValue": "[parameters('tagName')]" },
            "argEndpoint":     { "type": "String", "defaultValue": "[variables('argEndpoint')]" },
            "armEndpoint":     { "type": "String", "defaultValue": "[variables('armEndpoint')]" },
            "vmssApiVersion":  { "type": "String", "defaultValue": "[parameters('vmssApiVersion')]" },
            "action":          { "type": "String", "defaultValue": "deallocate" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": "[parameters('stopSchedule')]",
                "timeZone": "[parameters('scheduleTimeZone')]"
              }
            }
          },
          "actions": {
            "Find_VMSS": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('argEndpoint')",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" },
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "[variables('queryStop')]"
                }
              }
            },
            "Stop_Each_VMSS": {
              "type": "Foreach",
              "runAfter": { "Find_VMSS": [ "Succeeded" ] },
              "foreach": "@body('Find_VMSS')?['data']",
              "actions": {
                "Invoke_Action": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat(parameters('armEndpoint'), items('Stop_Each_VMSS')?['id'], '/', parameters('action'), '?api-version=', parameters('vmssApiVersion'))}",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicApp_AutoStop')]",
      "location": "[parameters('location')]",
      "tags": { "SolutionName": "StartStopV2", "ResourceType": "VMSS" },
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "[parameters('logicAppState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "subscriptionIds": { "type": "Array", "defaultValue": "[parameters('targetSubscriptionIds')]" },
            "tagName":         { "type": "String", "defaultValue": "[parameters('tagName')]" },
            "argEndpoint":     { "type": "String", "defaultValue": "[variables('argEndpoint')]" },
            "armEndpoint":     { "type": "String", "defaultValue": "[variables('armEndpoint')]" },
            "vmssApiVersion":  { "type": "String", "defaultValue": "[parameters('vmssApiVersion')]" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": "[parameters('autoStopRecurrenceMinutes')]"
              }
            }
          },
          "actions": {
            "Find_VMSS": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('argEndpoint')",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" },
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "[variables('queryAutoStop')]"
                }
              }
            },
            "AutoStop_Each_VMSS": {
              "type": "Foreach",
              "runAfter": { "Find_VMSS": [ "Succeeded" ] },
              "foreach": "@body('Find_VMSS')?['data']",
              "actions": {
                "Deallocate": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{concat(parameters('armEndpoint'), items('AutoStop_Each_VMSS')?['id'], '/deallocate?api-version=', parameters('vmssApiVersion'))}",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[variables('logicApp_ScaleToOne')]",
      "location": "[parameters('location')]",
      "tags": { "SolutionName": "StartStopV2", "ResourceType": "VMSS" },
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "state": "[parameters('logicAppState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "subscriptionIds": { "type": "Array", "defaultValue": "[parameters('targetSubscriptionIds')]" },
            "tagName":         { "type": "String", "defaultValue": "[parameters('scaleTagName')]" },
            "argEndpoint":     { "type": "String", "defaultValue": "[variables('argEndpoint')]" },
            "armEndpoint":     { "type": "String", "defaultValue": "[variables('armEndpoint')]" },
            "vmssApiVersion":  { "type": "String", "defaultValue": "[parameters('vmssApiVersion')]" },
            "targetCapacity":  { "type": "Int",    "defaultValue": "[parameters('scaleToOneCapacity')]" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": "[parameters('scaleToOneSchedule')]",
                "timeZone": "[parameters('scheduleTimeZone')]"
              }
            }
          },
          "actions": {
            "Find_VMSS": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@parameters('argEndpoint')",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" },
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "[variables('queryScaleToOne')]"
                }
              }
            },
            "ScaleToOne_Each_VMSS": {
              "type": "Foreach",
              "runAfter": { "Find_VMSS": [ "Succeeded" ] },
              "foreach": "@body('Find_VMSS')?['data']",
              "actions": {
                "Patch_Capacity": {
                  "type": "Http",
                  "inputs": {
                    "method": "PATCH",
                    "uri": "@{concat(parameters('armEndpoint'), items('ScaleToOne_Each_VMSS')?['id'], '?api-version=', parameters('vmssApiVersion'))}",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "@parameters('armEndpoint')" },
                    "body": {
                      "sku": { "capacity": "@parameters('targetCapacity')" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "condition": "[parameters('assignRbac')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('logicApp_Start'), variables('vmContributorRoleId'))]",
      "dependsOn": [ "[resourceId('Microsoft.Logic/workflows', variables('logicApp_Start'))]" ],
      "properties": {
        "roleDefinitionId": "[variables('vmContributorRoleDefId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicApp_Start')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[parameters('assignRbac')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('logicApp_Stop'), variables('vmContributorRoleId'))]",
      "dependsOn": [ "[resourceId('Microsoft.Logic/workflows', variables('logicApp_Stop'))]" ],
      "properties": {
        "roleDefinitionId": "[variables('vmContributorRoleDefId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicApp_Stop')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[parameters('assignRbac')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('logicApp_AutoStop'), variables('vmContributorRoleId'))]",
      "dependsOn": [ "[resourceId('Microsoft.Logic/workflows', variables('logicApp_AutoStop'))]" ],
      "properties": {
        "roleDefinitionId": "[variables('vmContributorRoleDefId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicApp_AutoStop')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "condition": "[parameters('assignRbac')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, variables('logicApp_ScaleToOne'), variables('vmContributorRoleId'))]",
      "dependsOn": [ "[resourceId('Microsoft.Logic/workflows', variables('logicApp_ScaleToOne'))]" ],
      "properties": {
        "roleDefinitionId": "[variables('vmContributorRoleDefId')]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', variables('logicApp_ScaleToOne')), '2019-05-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "startWorkflowId":      { "type": "string", "value": "[resourceId('Microsoft.Logic/workflows', variables('logicApp_Start'))]" },
    "stopWorkflowId":       { "type": "string", "value": "[resourceId('Microsoft.Logic/workflows', variables('logicApp_Stop'))]" },
    "autoStopWorkflowId":   { "type": "string", "value": "[resourceId('Microsoft.Logic/workflows', variables('logicApp_AutoStop'))]" },
    "scaleToOneWorkflowId": { "type": "string", "value": "[resourceId('Microsoft.Logic/workflows', variables('logicApp_ScaleToOne'))]" }
  }
}
