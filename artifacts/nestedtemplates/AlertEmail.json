{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",
  "parameters": {
    "Email Addresses": {
      "type": "string",
      "defaultValue": "REPLACE_ME@example.com",
      "metadata": {
        "description": "Recipients of the alert email. Separate multiple addresses with commas (,).",
        "category": "Email Functionality"
      }
    },
    "appInsightName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Application Insights component."
      }
    },
    "appInsightRegion": {
      "type": "string",
      "metadata": {
        "description": "Region of the Application Insights component (alerts are co-located)."
      }
    }
  },
  "variables": {
    "emailSplit": "[split(parameters('Email Addresses'),',')]",
    "actionGroupName": "StartStopV2_VM_Notification",
    "actionGroupShortName": "StStAlertV2",
    "appInsightId": "[resourceId('Microsoft.Insights/components', parameters('appInsightName'))]",
    "alertArray": [
      {
        "alertName": "ScheduledStartStop_AzFunc",
        "alertDescription": "Start/Stop VMs during off-hours: Scheduled azure function has attempted an action.",
        "query": "traces\n| where (operation_Name contains \"Scheduled\")\n| where ( message hasprefix \"~Scheduled\" )\n| extend output = substring(message,1)\n| summarize by message, output\n| project output",
        "emailSubject": "Start/Stop VMs during off-hours: Scheduled azure function has attempted an action"
      },
      {
        "alertName": "SequencedStartStop_AzFunc",
        "alertDescription": "Start/Stop VMs during off-hours: Sequenced azure function has attempted an action.",
        "query": "traces\n| where (operation_Name contains \"Scheduled\")\n| where ( message hasprefix \"~Sequenced\" )\n| extend output = substring(message,1)\n| summarize by message, output\n| project output",
        "emailSubject": "Start/Stop VMs during off-hours: Sequenced azure function has attempted an action"
      },
      {
        "alertName": "AutoStop_VM_AzFunc",
        "alertDescription": "Start/Stop VMs during off-hours: AutoStop azure function has attempted an action.",
        "query": "traces\n| where (operation_Name contains \"AutoStop\")\n| where ( message hasprefix \"~AutoStop\" )\n| extend output = substring(message,1)\n| summarize by message, output\n| project output",
        "emailSubject": "Start/Stop VMs during off-hours: AutoStop azure function has attempted an action"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[variables('actionGroupName')]",
      "location": "Global",
      "properties": {
        "groupShortName": "[variables('actionGroupShortName')]",
        "enabled": true,
        "copy": [
          {
            "name": "emailReceivers",
            "count": "[length(variables('emailSplit'))]",
            "input": {
              "emailAddress": "[trim(variables('emailSplit')[copyIndex('emailReceivers')])]",
              "name": "[concat('Email', uniqueString(string(copyIndex('emailReceivers'))))]",
              "useCommonAlertSchema": true
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-03-15-preview",
      "name": "[variables('alertArray')[copyIndex()].alertName]",
      "location": "[parameters('appInsightRegion')]",
      "tags": {
        "[concat('hidden-link:', variables('appInsightId'))]": "Resource"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ],
      "copy": {
        "name": "alertLoop",
        "count": "[length(variables('alertArray'))]"
      },
      "properties": {
        "displayName": "[variables('alertArray')[copyIndex()].alertName]",
        "description": "[variables('alertArray')[copyIndex()].alertDescription]",
        "severity": 4,
        "enabled": true,
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "scopes": [
          "[variables('appInsightId')]"
        ],
        "targetResourceTypes": [
          "Microsoft.Insights/components"
        ],
        "criteria": {
          "allOf": [
            {
              "query": "[variables('alertArray')[copyIndex()].query]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "autoMitigate": true,
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          ],
          "customProperties": {
            "emailSubject": "[variables('alertArray')[copyIndex()].emailSubject]"
          }
        }
      }
    }
  ],
  "outputs": {
    "actionGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
    },
    "appInsightId": {
      "type": "string",
      "value": "[variables('appInsightId')]"
    }
  }
}
