{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "azureFunctionAppName": {
      "type": "string",
      "minLength": 2,
      "metadata": {
        "description": "The name of the Azure Function App that will perform the action on the VM(s). This Function App name MUST be globally unique, contain ONLY alphanumeric characters or hyphens (and can NOT start or end with a hyphen), and the length of the name MUST be less than 46 characters."
      }
    },
    "applicationInsightsName": {
      "type": "string",
      "metadata": {
        "description": "The name of the Application Insights instance that will hold the analytics for Start/Stop."
      }
    },
    "applicationInsightsRegion": {
      "type": "string",
      "defaultValue": "usgovvirginia",
      "allowedValues": [
        "usgovvirginia",
        "usgovarizona"
      ],
      "metadata": {
        "description": "The region where the Application Insights instance for Start/Stop Analytics will be located."
      }
    },
    "storageAccountName": {
      "type": "String",
      "minLength": 3,
      "metadata": {
        "description": "The name of the storage account for Start/Stop execution data logging. Name MUST be globally unique and contain only lowercase letters and numbers. Length of the name MUST be less than 18 characters."
      }
    },
    "workspaceName": {
      "type": "string",
      "defaultValue": "ststv2Workspace",
      "metadata": {
        "description": "The name of the log analytics workspace instance that will store all future ingested Application Insights telemetry for Start/Stop. Name must be unique per resource group."
      }
    },
    "workspaceRegion": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The region where the Log Analytics workspace for Start/Stop will be located."
      }
    },
    "alertEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional. Email address to receive Start/Stop V2 alerts. Comma-separate multiple addresses."
      }
    },
    "scheduleTimeZone": {
      "type": "string",
      "defaultValue": "Pacific Standard Time",
      "metadata": {
        "description": "Time zone used by the Logic App scheduler triggers (Windows time-zone ID, e.g. 'GMT Standard Time')."
      },
      "allowedValues": [
        "Dateline Standard Time",
        "UTC-11",
        "Aleutian Standard Time",
        "Hawaiian Standard Time",
        "Alaskan Standard Time",
        "Pacific Standard Time",
        "Mountain Standard Time",
        "Central Standard Time",
        "Eastern Standard Time",
        "Atlantic Standard Time",
        "Newfoundland Standard Time",
        "E. South America Standard Time",
        "Argentina Standard Time",
        "UTC-02",
        "Azores Standard Time",
        "GMT Standard Time",
        "Greenwich Standard Time",
        "UTC",
        "W. Europe Standard Time",
        "Central Europe Standard Time",
        "Romance Standard Time",
        "Central European Standard Time",
        "E. Europe Standard Time",
        "Egypt Standard Time",
        "South Africa Standard Time",
        "FLE Standard Time",
        "Turkey Standard Time",
        "Israel Standard Time",
        "Arabic Standard Time",
        "Arab Standard Time",
        "Russian Standard Time",
        "Iran Standard Time",
        "Arabian Standard Time",
        "Azerbaijan Standard Time",
        "Pakistan Standard Time",
        "India Standard Time",
        "Sri Lanka Standard Time",
        "Bangladesh Standard Time",
        "SE Asia Standard Time",
        "China Standard Time",
        "Singapore Standard Time",
        "W. Australia Standard Time",
        "Taipei Standard Time",
        "Tokyo Standard Time",
        "Korea Standard Time",
        "Cen. Australia Standard Time",
        "AUS Central Standard Time",
        "AUS Eastern Standard Time",
        "Tasmania Standard Time",
        "Vladivostok Standard Time",
        "New Zealand Standard Time"
      ]
    },
    "logicAppState": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Enabled",
        "Disabled"
      ],
      "metadata": {
        "description": "Initial state of the deployed Logic Apps. Keep Disabled until you've set targetResourceGroups and adjusted schedules."
      }
    }
  },
  "variables": {
    "_artifactsLocation": "https://raw.githubusercontent.com/GHogbin/startstopv2-deployments/main/artifacts",
    "nestedTemplates": {
      "StartStopV2_Automationgov": "[concat(variables('_artifactsLocation'), '/nestedtemplates/AutomationUpdateff.json')]",
      "StartStopV2_AzDashboardgov": "[concat(variables('_artifactsLocation'), '/nestedtemplates/AzDashboard.json')]",
      "StartStopV2_LogicApps": "[concat(variables('_artifactsLocation'), '/nestedtemplates/LogicApps.json')]",
      "StartStopV2_AlertEmail": "[concat(variables('_artifactsLocation'), '/nestedtemplates/AlertEmail.json')]"
    },
    "resourceGroupName": "[resourceGroup().name]",
    "resourceGroupRegion": "[resourceGroup().location]",
    "azureCloudEnvironment": "AzureUSGovernment",
    "ssv2Version": "1.1.20241024.1",
    "workSpaceRegion": "[if(empty(parameters('workspaceRegion')), resourceGroup().location, parameters('workspaceRegion'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "SSV2_AutomationUpdateGov",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[variables('nestedTemplates').StartStopV2_Automationgov]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "azureFunctionAppName": {
            "value": "[parameters('azureFunctionAppName')]"
          },
          "applicationInsightsName": {
            "value": "[parameters('applicationInsightsName')]"
          },
          "applicationInsightsRegion": {
            "value": "[parameters('applicationInsightsRegion')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "workspaceName": {
            "value": "[parameters('workspaceName')]"
          },
          "workspaceRegion": {
            "value": "[variables('workspaceRegion')]"
          },
          "azureCloudEnvironment": {
            "value": "[variables('azureCloudEnvironment')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "SSV2_AzDashboardUpdateGov",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "SSV2_AutomationUpdateGov"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[variables('nestedTemplates').StartStopV2_AzDashboardgov]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "appInsightName": {
            "value": "[parameters('applicationInsightsName')]"
          },
          "appInsightRegion": {
            "value": "[parameters('applicationInsightsRegion')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "SSV2_LogicAppsGov",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "SSV2_AutomationUpdateGov"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[variables('nestedTemplates').StartStopV2_LogicApps]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "functionAppName": {
            "value": "[parameters('azureFunctionAppName')]"
          },
          "location": {
            "value": "[variables('resourceGroupRegion')]"
          },
          "scheduleTimeZone": {
            "value": "[parameters('scheduleTimeZone')]"
          },
          "logicAppState": {
            "value": "[parameters('logicAppState')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2021-04-01",
      "name": "SSV2_AlertEmailGov",
      "resourceGroup": "[variables('resourceGroupName')]",
      "dependsOn": [
        "SSV2_AutomationUpdateGov"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[variables('nestedTemplates').StartStopV2_AlertEmail]",
          "contentVersion": "2.0.0.0"
        },
        "parameters": {
          "Email Addresses": {
            "value": "[if(empty(parameters('alertEmail')), 'REPLACE_ME@example.com', parameters('alertEmail'))]"
          },
          "appInsightName": {
            "value": "[parameters('applicationInsightsName')]"
          },
          "appInsightRegion": {
            "value": "[parameters('applicationInsightsRegion')]"
          }
        }
      }
    }
  ],
  "outputs": {}
}
